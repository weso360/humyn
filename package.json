{
  "name": "streamlink",
  "version": "1.0.0",
  "description": "WebRTC peer-to-peer streaming — phone camera to OBS at 4K/HD",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"nodemon server.js\" \"cd client && npm start\"",
    "build": "cd client && npm install && npm run build",
    "build:client": "cd client && npm run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.3",
    "nodemon": "^2.0.22"
  },
  "keywords": [
    "webrtc",
    "streaming",
    "obs",
    "4k",
    "phone",
    "camera"
  ],
  "author": "",
  "license": "MIT"
}
